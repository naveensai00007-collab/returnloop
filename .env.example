# Supabase (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI Provider (OpenRouter or Groq for receipt extraction)
OPENROUTER_API_KEY=
GROQ_API_KEY=
AI_MODEL=meta-llama/llama-3.2-11b-vision-instruct:free
AI_TIMEOUT_MS=20000

# Email Delivery (Resend for deadline reminders)
RESEND_API_KEY=
EMAIL_FROM=reminders@yourdomain.com

# Cron Trigger Security
CRON_SECRET=your-secure-random-string-at-least-32-chars

# Analytics (Optional)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
